<!-- 雷达实现 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- 1.需要声明变量 -->
    <!-- 雷达尺寸 -->
    <xacro:property name="laser_radius" value="0.03"/>
    <xacro:property name="laser_lenght" value="0.03"/>
    <!-- 雷达关节的偏移量 -->
    <xacro:property name="laser_joint_x" value="0"/>
    <xacro:property name="laser_joint_y" value="0"/>
    <xacro:property name="laser_joint_z" value="${car_height / 2 + laser_lenght / 2}"/>
    <!-- 2.设置link和joint -->
    <link name="laser">
        <visual>
            <geometry>
                <cylinder radius="${laser_radius}" length="${laser_lenght}"/>
            </geometry>
            <material name="blue">
                <color rgba="0.1 0.1 0.7 0.8"/>
            </material>
        </visual>
    </link>
    <joint name="laser2base_link" type="fixed">
        <parent link="base_link"/>
        <child link="laser"/>
        <origin xyz="${laser_joint_x} ${laser_joint_y} ${laser_joint_z}"/>
    </joint>
</robot>